# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Reference files (not part of the app)
.stitch/
.firecrawl/

# Owner photo source dump (renamed originals + Live Photo clips) — see iCloud Photos/PHOTOS.md
iCloud Photos/

# Google service-account keys — never commit (Phase 9 D-18; the key lives in
# ~/.config/tps-klimaattechniek/ and in the GitHub Actions secret only)
gsc-service-account*.json
*.serviceaccount.json
secrets/

# Google service-account keys must never enter the repo (Phase 9, D-18). `/.config/` is
# anchored to the repo root — a stray key copy landed there once; the two filename
# patterns below stay unanchored on purpose, because a key is a key at any depth.
/.config/
tps-klimaattechniek-seo-*.json
*service-account*.json
